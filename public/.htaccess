Options -Indexes

RewriteEngine On

# 1. Route sensitive uploads through index.php for authentication verification
RewriteRule ^uploads/(cases|reports|signatures|receipts)/(.*)$ index.php [L,NC]

# 2. If the request is a real file or directory (and not sensitive uploads), serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 3. Otherwise, route everything to index.php
RewriteRule ^ index.php [L,QSA]
