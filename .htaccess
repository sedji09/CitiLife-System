RewriteEngine On

# Case-insensitive rewrite for app/api requests so both app/api and app/Api work on Linux/Railway
RewriteRule ^app/api/(.*)$ app/Api/$1 [L,NC]

# Existing files
RewriteCond %{REQUEST_FILENAME} -f [OR]

# Existing directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect everything else to public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]